<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="32dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="朝夕" android:textSize="18sp" android:textStyle="bold" android:textColor="#22384A"
            android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/widget_date" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:text="今天 · 最近安排"
            android:textSize="11sp" android:textColor="#647584" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="32dp" android:layout_height="32dp"
            android:text="↻" android:textSize="20sp" android:textColor="#577187" android:gravity="center"
            android:background="@drawable/widget_action_background" android:contentDescription="刷新日程" />
        <TextView android:id="@+id/widget_add" android:layout_width="32dp" android:layout_height="32dp"
            android:layout_marginStart="4dp" android:text="＋" android:textSize="20sp" android:textColor="#B34F38"
            android:gravity="center" android:background="@drawable/widget_action_background" android:contentDescription="新建日程" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical" android:baselineAligned="false">
        <LinearLayout android:id="@+id/widget_day_panel" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="vertical"
            android:gravity="center" android:layout_marginEnd="8dp">
            <TextView android:id="@+id/widget_day_number" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="30sp" android:textStyle="bold" android:textColor="#B34F38" />
            <TextView android:id="@+id/widget_month_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#647584" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_row_1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false"
            android:visibility="gone">
            <ImageView android:id="@+id/widget_complete_1" android:layout_width="44dp" android:layout_height="44dp"
                android:padding="10dp" android:scaleType="centerInside" android:src="@drawable/widget_complete_circle"
                android:focusable="true" android:contentDescription="标记完成" />
            <TextView android:id="@+id/widget_label_1" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="44dp" android:gravity="center_vertical"
                android:textSize="13sp" android:textColor="#273D4F" android:singleLine="true" android:ellipsize="end"
                android:focusable="true" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_row_2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false"
            android:visibility="gone">
            <ImageView android:id="@+id/widget_complete_2" android:layout_width="44dp" android:layout_height="44dp"
                android:padding="10dp" android:scaleType="centerInside" android:src="@drawable/widget_complete_circle"
                android:focusable="true" android:contentDescription="标记完成" />
            <TextView android:id="@+id/widget_label_2" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="44dp" android:gravity="center_vertical"
                android:textSize="13sp" android:textColor="#273D4F" android:singleLine="true" android:ellipsize="end"
                android:focusable="true" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_row_3" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false"
            android:visibility="gone">
            <ImageView android:id="@+id/widget_complete_3" android:layout_width="44dp" android:layout_height="44dp"
                android:padding="10dp" android:scaleType="centerInside" android:src="@drawable/widget_complete_circle"
                android:focusable="true" android:contentDescription="标记完成" />
            <TextView android:id="@+id/widget_label_3" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="44dp" android:gravity="center_vertical"
                android:textSize="13sp" android:textColor="#273D4F" android:singleLine="true" android:ellipsize="end"
                android:focusable="true" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_row_4" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false"
            android:visibility="gone">
            <ImageView android:id="@+id/widget_complete_4" android:layout_width="44dp" android:layout_height="44dp"
                android:padding="10dp" android:scaleType="centerInside" android:src="@drawable/widget_complete_circle"
                android:focusable="true" android:contentDescription="标记完成" />
            <TextView android:id="@+id/widget_label_4" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="44dp" android:gravity="center_vertical"
                android:textSize="13sp" android:textColor="#273D4F" android:singleLine="true" android:ellipsize="end"
                android:focusable="true" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_row_5" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false"
            android:visibility="gone">
            <ImageView android:id="@+id/widget_complete_5" android:layout_width="44dp" android:layout_height="44dp"
                android:padding="10dp" android:scaleType="centerInside" android:src="@drawable/widget_complete_circle"
                android:focusable="true" android:contentDescription="标记完成" />
            <TextView android:id="@+id/widget_label_5" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="44dp" android:gravity="center_vertical"
                android:textSize="13sp" android:textColor="#273D4F" android:singleLine="true" android:ellipsize="end"
                android:focusable="true" />
        </LinearLayout>
        <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="#647584" android:gravity="center_vertical"
            android:singleLine="true" android:ellipsize="end" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="18dp" android:text="轻点日程查看详情" android:textSize="11sp" android:textColor="#647584"
        android:singleLine="true" android:ellipsize="end" />
</LinearLayout>
